<Window x:Class="TrayX.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrayX.UI.Localization"
        xmlns:vm="clr-namespace:TrayX.UI.ViewModels"
        xmlns:views="clr-namespace:TrayX.UI.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TrayX"
        Icon="pack://application:,,,/Assets/trayx.ico"
        Width="1000"
        Height="660"
        MinWidth="860"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource TrayX.BackgroundBrush}"
        Foreground="{DynamicResource TrayX.TextBrush}"
        FontFamily="{StaticResource TrayX.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown"
        Closing="OnClosing"
        StateChanged="OnStateChanged"
        IsVisibleChanged="OnIsVisibleChanged"
        Activated="OnActivatedState">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplaysViewModel}">
            <views:DisplaysPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrayIconsViewModel}">
            <views:TrayIconsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrayAppsViewModel}">
            <views:TrayAppsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindhawkViewModel}">
            <views:WindhawkPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="{DynamicResource TrayX.WindowGlowBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource TrayX.WindowGlowSecondaryBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="30"
                            Height="30"
                            Background="{DynamicResource TrayX.AccentGradientBrush}"
                            CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="T" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource TrayX.DisplayFontFamily}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="TrayX" />
                    <Border Margin="12,0,0,0"
                            Padding="9,4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TrayX.SurfaceAltBrush}"
                            BorderBrush="{DynamicResource TrayX.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource TrayX.SuccessBrush}"
                                     Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource TrayX.WarningBrush}"
                                     Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Width="7"
                                     Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource TrayX.DangerBrush}"
                                     Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                       Text="{Binding ConnectionText}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayX.TextFaintBrush}"
                               Style="{StaticResource Caption}"
                               Text="{Binding Tagline}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding OpenQuickPanelCommand}"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{loc:Loc Quick_Title}">
                        <Path Data="{StaticResource Icon.Panel}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Command="{Binding ToggleMuteCommand}"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{Binding MuteTooltip}">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource Icon.Volume}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.Mute}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ToggleWindowsThemeCommand}"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{Binding ThemeTooltip}">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource Icon.Moon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowsDark}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.Sun}"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowsDark}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{loc:Loc Header_Settings}">
                        <Path Data="{StaticResource Icon.Settings}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Border Width="1"
                            Height="18"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TrayX.BorderBrush}" />

                    <Button Click="OnMinimizeClick"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{loc:Loc Window_Minimize}">
                        <Path Data="{StaticResource Icon.Minimize}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="OnMaximizeClick"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{loc:Loc Window_Maximize}">
                        <Path x:Name="MaximizeIcon"
                              Data="{StaticResource Icon.Maximize}"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Width="12"
                              Height="12" />
                    </Button>
                    <Button Click="OnCloseClick"
                            Style="{StaticResource CloseTitleBarButton}"
                            ToolTip="{loc:Loc Window_Close}">
                        <Path Data="{StaticResource Icon.Close}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="16,10"
                    Background="{DynamicResource TrayX.DangerSoftBrush}"
                    BorderBrush="{DynamicResource TrayX.DangerBrush}"
                    BorderThickness="0,1,0,1"
                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayX.DangerBrush}"
                               Style="{StaticResource Caption}"
                               Text="{loc:Loc Shell_CoreOfflineHint}" />
                    <Button Grid.Column="1"
                            Padding="12,5"
                            Command="{Binding ReconnectCommand}"
                            Content="{loc:Loc Common_Retry}"
                            Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource TrayX.SurfaceBrush}"
                        BorderBrush="{DynamicResource TrayX.BorderBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid Margin="12,16,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="NavigationList"
                                 ItemContainerStyle="{StaticResource NavListBoxItem}"
                                 ItemsSource="{Binding Navigation}"
                                 SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                                 Style="{StaticResource PlainListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              Data="{Binding Icon}"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.5" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Margin="10,10,10,0">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                       Style="{StaticResource Faint}"
                                       Text="{Binding VersionText}" />
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                       Style="{StaticResource Faint}"
                                       Text="{Binding StatusHint}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="28,22,28,0">
                        <TextBlock Style="{StaticResource H1}" Text="{Binding CurrentPage.Title}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding CurrentPage.Subtitle}" />
                    </StackPanel>

                    <ContentControl Grid.Row="1"
                                    Margin="28,18,14,18"
                                    Content="{Binding CurrentPage}"
                                    Focusable="False" />
                </Grid>

                <Border Grid.Column="1"
                        Margin="0,0,0,22"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource TrayX.SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource TrayX.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsHitTestVisible="False"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          Direction="270"
                                          Opacity="0.45"
                                          ShadowDepth="6"
                                          Color="#000000" />
                    </Border.Effect>
                    <TextBlock FontSize="12" Text="{Binding ToastMessage}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
