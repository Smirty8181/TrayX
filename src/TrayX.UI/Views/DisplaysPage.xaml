<UserControl x:Class="TrayX.UI.Views.DisplaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,14,8">
            <Border Margin="0,0,0,12" Padding="14,12" Style="{StaticResource CardAlt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Caption}"
                               Text="{Binding CountText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Common_Refresh}">
                            <Path Data="{StaticResource Icon.Refresh}"
                                  Style="{StaticResource PathIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Margin="6,0,0,0"
                                Command="{Binding IdentifyCommand}"
                                Content="{loc:Loc Displays_Identify}"
                                Style="{StaticResource GhostButton}" />
                        <Button Margin="6,0,0,0"
                                Command="{Binding OpenSettingsCommand}"
                                Content="{loc:Loc Displays_WindowsSettings}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Displays}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32"
                                                Height="32"
                                                Background="{DynamicResource TrayX.AccentSoftBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TrayX.AccentBrush}"
                                                       Text="{Binding Index}" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource H2}" Text="{Binding FriendlyName}" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource TrayX.SuccessSoftBrush}"
                                                        CornerRadius="999"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource TrayX.SuccessBrush}"
                                                               Text="{loc:Loc Displays_Primary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                       Style="{StaticResource MonoValue}"
                                                       Text="{Binding DeviceName}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_Resolution}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding ResolutionText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_RefreshRate}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding RefreshText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_Dpi}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding DpiText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_Orientation}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding OrientationText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_WorkArea}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding WorkAreaText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{loc:Loc Displays_Brightness}" />
                                            <TextBlock Style="{StaticResource MonoValue}" Text="{Binding BrightnessText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Padding="14"
                                        Background="{DynamicResource TrayX.SurfaceAltBrush}"
                                        CornerRadius="14">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource Caption}"
                                                       Text="{loc:Loc Displays_Brightness}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource MonoValue}"
                                                       Text="{Binding BrightnessText}" />
                                        </Grid>
                                        <Slider Margin="0,8,0,0"
                                                Maximum="100"
                                                Minimum="0"
                                                Style="{StaticResource NeonSlider}"
                                                Value="{Binding BrightnessValue, Mode=TwoWay}"
                                                Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Foreground="{DynamicResource TrayX.WarningBrush}"
                                                   Style="{StaticResource Caption}"
                                                   Text="{loc:Loc Displays_BrightnessUnsupported}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ShowUnsupported, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Margin="0,14,0,0"
                                                Padding="0,12,0,0"
                                                BorderBrush="{DynamicResource TrayX.BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Visibility="{Binding ShowTrayPanelControl, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,12,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                           Style="{StaticResource Caption}"
                                                           Text="{loc:Loc Displays_TrayPanel}" />
                                                <ToggleButton Grid.Column="1"
                                                              IsChecked="{Binding TrayPanelEnabled, Mode=OneWay}"
                                                              Click="OnTrayPanelToggle"
                                                              Style="{StaticResource Switch}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource InfoBar}"
                    Visibility="{Binding HasDisplays, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Displays_NoDisplays}" />
            </Border>

            <Border Style="{StaticResource InfoBar}">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Displays_Note}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
