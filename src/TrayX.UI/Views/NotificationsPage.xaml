<UserControl x:Class="TrayX.UI.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding CountText}" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                           Style="{StaticResource Faint}"
                           Text="{loc:Loc Notifications_Retention}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Common_Refresh}">
                    <Path Data="{StaticResource Icon.Refresh}"
                          Style="{StaticResource PathIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Margin="8,0,0,0"
                        Command="{Binding ClearCommand}"
                        Content="{loc:Loc Notifications_Clear}"
                        IsEnabled="{Binding CanClear}"
                        Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,14,0">
            <ListBox ItemsSource="{Binding Items}"
                     AutomationProperties.Name="{loc:Loc Notifications_History}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource RowListBoxItem}"
                     Style="{StaticResource PlainListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                               Style="{StaticResource Faint}"
                                               Text="{Binding CreatedText}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Body}"
                                           Text="{Binding Message}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,0,0,12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Style="{StaticResource InfoBar}"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Notifications_Empty}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
