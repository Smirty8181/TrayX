<UserControl x:Class="TrayX.UI.Views.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,14,8">
            <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="46"
                            Height="46"
                            VerticalAlignment="Top"
                            Background="{DynamicResource TrayX.AccentSoftBrush}"
                            CornerRadius="14">
                        <Path Width="20"
                              Height="20"
                              Data="{StaticResource Icon.VolumeWaves}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TrayX.AccentBrush}"
                              StrokeThickness="1.6" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,18,0">
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Audio_OutputDevice}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource H2}"
                                   Text="{Binding DeviceName}"
                                   TextTrimming="CharacterEllipsis" />
                        <Slider Margin="0,14,0,0"
                                Maximum="100"
                                Minimum="0"
                                IsEnabled="{Binding HasDevice}"
                                Style="{StaticResource NeonSlider}"
                                Value="{Binding MasterVolume, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding SessionsText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource Metric}"
                                   Text="{Binding MasterVolumeText}" />
                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{Binding MuteTooltip}">
                                <Grid Width="18" Height="18">
                                    <Path Data="{StaticResource Icon.Volume}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource Icon.Mute}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Margin="6,0,0,0"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{loc:Loc Common_Refresh}">
                                <Path Data="{StaticResource Icon.Refresh}"
                                      Style="{StaticResource PathIcon}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Margin="6,0,0,0"
                                    Command="{Binding ToggleCompactCommand}"
                                    Content="{Binding CompactButtonText}"
                                    Style="{StaticResource SubtleButton}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource WarningBar}"
                    Visibility="{Binding IsHighVolumeWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.WarningBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding HighVolumeWarningText}" />
            </Border>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource WarningBar}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.WarningBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding Error}" />
            </Border>

            <Border Margin="0,0,0,12"
                    Padding="14,10"
                    Style="{StaticResource CardAlt}"
                    Visibility="{Binding DetailsVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Audio_InputLevel}" />
                        <ProgressBar Height="8"
                                     Margin="0,8,12,0"
                                     Maximum="1"
                                     Minimum="0"
                                     Value="{Binding InputPeakLevel, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource MonoValue}"
                               Text="{Binding InputPeakPercent}" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12" Visibility="{Binding DetailsVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource CardAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc Audio_Outputs}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding OutputDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4"
                                            Padding="8"
                                            Background="{DynamicResource TrayX.SurfaceBrush}"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Data="{StaticResource Icon.Volume}"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource TrayX.TextMutedBrush}"
                                                          StrokeThickness="1.4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Flow}" Value="capture">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.Microphone}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        Background="{DynamicResource TrayX.AccentSoftBrush}"
                                                        CornerRadius="999"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource TrayX.AccentBrush}"
                                                               Text="{loc:Loc Audio_Default}" />
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ToggleFavoriteCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{Binding FavoriteTooltip}">
                                                    <Path Data="{StaticResource Icon.Star}"
                                                          Style="{StaticResource FavoriteDeviceIcon}" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding SetDefaultCommand}"
                                                        IsEnabled="{Binding CanSetDefault}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{loc:Loc Audio_SetDefault}">
                                                    <Path Data="{StaticResource Icon.Check}"
                                                          Style="{StaticResource PathIcon}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ToggleMuteCommand}"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{Binding MuteTooltip}">
                                                    <Path Data="{StaticResource Icon.Mute}"
                                                          Style="{StaticResource PathIcon}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Maximum="100"
                                                        Minimum="0"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource NeonSlider}"
                                                        Value="{Binding Volume, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                           Style="{StaticResource Faint}"
                                                           Text="{Binding Volume, StringFormat={}{0:0}%}"
                                                           Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc Audio_Inputs}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding InputDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4"
                                            Padding="8"
                                            Background="{DynamicResource TrayX.SurfaceBrush}"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Data="{StaticResource Icon.Volume}"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource TrayX.TextMutedBrush}"
                                                          StrokeThickness="1.4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Flow}" Value="capture">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.Microphone}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        Background="{DynamicResource TrayX.AccentSoftBrush}"
                                                        CornerRadius="999"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource TrayX.AccentBrush}"
                                                               Text="{loc:Loc Audio_Default}" />
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ToggleFavoriteCommand}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{Binding FavoriteTooltip}">
                                                    <Path Data="{StaticResource Icon.Star}"
                                                          Style="{StaticResource FavoriteDeviceIcon}" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding SetDefaultCommand}"
                                                        IsEnabled="{Binding CanSetDefault}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{loc:Loc Audio_SetDefault}">
                                                    <Path Data="{StaticResource Icon.Check}"
                                                          Style="{StaticResource PathIcon}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding ToggleMuteCommand}"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{Binding MuteTooltip}">
                                                    <Path Data="{StaticResource Icon.Mute}"
                                                          Style="{StaticResource PathIcon}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Maximum="100"
                                                        Minimum="0"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource NeonSlider}"
                                                        Value="{Binding Volume, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                           Style="{StaticResource Faint}"
                                                           Text="{Binding Volume, StringFormat={}{0:0}%}"
                                                           Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource Card}"
                    Visibility="{Binding DetailsVisibility}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Audio_Sessions}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding SessionsText}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Audio_NoSessions}"
                               Visibility="{Binding ShowSessionsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4"
                                        Padding="10,8"
                                        Background="{DynamicResource TrayX.SurfaceAltBrush}"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                                            <Path Width="15"
                                                  Height="15"
                                                  Data="{StaticResource Icon.Music}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TrayX.TextMutedBrush}"
                                                  StrokeThickness="1.4" />
                                            <Image Width="22"
                                                   Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding ProcessPath, Converter={StaticResource ShellIcon}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{Binding ProcessPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ProcessPath, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>

                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Maximum="100"
                                                    Minimum="0"
                                                    Style="{StaticResource NeonSlider}"
                                                    Value="{Binding Volume, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1"
                                                       Width="34"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                       Style="{StaticResource MonoValue}"
                                                       Text="{Binding Volume, StringFormat={}{0:0}}" />
                                        </Grid>

                                        <Button Grid.Column="3"
                                                Margin="6,0,0,0"
                                                Command="{Binding OpenRoutingSettingsCommand}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="{loc:Loc Audio_AppRouting}">
                                            <TextBlock Text="…" />
                                        </Button>

                                        <Button Grid.Column="4" Command="{Binding ToggleMuteCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="ToolTip" Value="{loc:Loc Audio_SessionMute}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Muted}" Value="True">
                                                            <Setter Property="ToolTip" Value="{loc:Loc Audio_SessionUnmute}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid Width="16" Height="16">
                                                <Path Data="{StaticResource Icon.Volume}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path Data="{StaticResource Icon.Mute}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBar}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Audio_Limitation}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenSoundSettingsCommand}"
                            Content="{loc:Loc Audio_OpenSettings}"
                            Style="{StaticResource SubtleButton}" />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenClassicSoundCommand}"
                            Content="{loc:Loc Audio_OpenClassicSettings}"
                            Style="{StaticResource SubtleButton}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
