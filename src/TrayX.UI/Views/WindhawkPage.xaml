<UserControl x:Class="TrayX.UI.Views.WindhawkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,14,8">
            <Border Margin="0,0,0,12" Style="{StaticResource InfoBar}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{loc:Loc Windhawk_Independent}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Windhawk_Explanation}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Windhawk_StatusTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Body}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding RefreshStatusCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="{loc:Loc Common_Refresh}">
                        <Path Data="{StaticResource Icon.Refresh}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding OpenWindhawkCommand}"
                            Content="{loc:Loc Windhawk_OpenWebsite}"
                            Style="{StaticResource GhostButton}" />
                </Grid>
            </Border>

            <Border Margin="0,0,0,12" Style="{StaticResource WarningBar}">
                <TextBlock Foreground="{DynamicResource TrayX.WarningBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Windhawk_Warnings}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Margin="2,6,0,8"
                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                       Style="{StaticResource H2}"
                       Text="{loc:Loc Windhawk_Recommendations}" />

            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                               Style="{StaticResource Body}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                               Style="{StaticResource Faint}"
                                               Text="{Binding ProcessText}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                               Style="{StaticResource Faint}"
                                               Text="{Binding Risk}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Command="{Binding OpenCommand}"
                                        Content="{loc:Loc Windhawk_ViewMod}"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,2,0,12" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{loc:Loc Windhawk_StyleTitle}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Windhawk_StyleDescription}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TrayX.TextFaintBrush}"
                               Style="{StaticResource Faint}"
                               Text="{loc:Loc Windhawk_Undo}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
