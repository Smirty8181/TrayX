<Window x:Class="TrayX.UI.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrayX.UI.Localization"
        Title="TrayX"
        Icon="pack://application:,,,/Assets/trayx.ico"
        Width="404"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource TrayX.FontFamily}"
        Foreground="{DynamicResource TrayX.TextBrush}"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
    <Border Margin="16"
            Padding="20"
            Background="{DynamicResource TrayX.SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource TrayX.BorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              Direction="270"
                              Opacity="0.6"
                              ShadowDepth="10"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28"
                        Height="28"
                        Background="{DynamicResource TrayX.AccentGradientBrush}"
                        CornerRadius="9">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="T" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Quick_Title}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource TrayX.SuccessBrush}"
                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                        <Ellipse Width="6"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource TrayX.DangerBrush}"
                                 Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Margin="5,0,0,0"
                                   Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                   Style="{StaticResource Faint}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Quick_Close}">
                    <Path Data="{StaticResource Icon.Close}"
                          Style="{StaticResource PathIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <Border Margin="0,14,0,0" Style="{StaticResource CardAlt}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding PreviousMonthCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Quick_PreviousMonth}">
                            <Path Data="{StaticResource Icon.Chevron}"
                                  Style="{StaticResource PathIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding CalendarTitle}" />
                        <Button Grid.Column="2"
                                Command="{Binding ThisMonthCommand}"
                                Content="{loc:Loc Quick_Today}"
                                Style="{StaticResource GhostButton}" />
                        <Button Grid.Column="3"
                                Command="{Binding NextMonthCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Quick_NextMonth}">
                            <Path Data="{StaticResource Icon.Chevron}"
                                  Style="{StaticResource PathIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                    <ItemsControl Margin="0,8,0,2" ItemsSource="{Binding WeekdayNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="1"
                                                    Padding="2"
                                                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Number}"
                                                    MinHeight="28">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource TrayX.AccentBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TrayX.AccentSoftBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TrayX.AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding OpenDateTimeSettingsCommand}"
                                Content="{loc:Loc Quick_OpenWindowsCalendar}"
                                Style="{StaticResource GhostButton}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Faint}"
                                   Text="{Binding SelectedDateText}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource CardAlt}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Quick_Volume}" />
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MonoValue}"
                                   Text="{Binding MasterVolumeText}" />
                        <Button Grid.Column="2"
                                Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="{Binding MuteTooltip}">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Volume}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource Icon.Mute}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </Grid>
                    <Slider Margin="0,6,0,0"
                            Maximum="100"
                            Minimum="0"
                            Style="{StaticResource NeonSlider}"
                            Value="{Binding MasterVolume, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0"
                    Style="{StaticResource CardAlt}"
                    Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Quick_Brightness}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource MonoValue}"
                                   Text="{Binding BrightnessText}" />
                    </Grid>
                    <Slider Margin="0,6,0,0"
                            Maximum="100"
                            Minimum="0"
                            Style="{StaticResource NeonSlider}"
                            Value="{Binding Brightness, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource CardAlt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Caption}"
                               Text="{loc:Loc Quick_WindowsTheme}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Command="{Binding SetWindowsThemeCommand}"
                                     CommandParameter="dark"
                                     Content="{loc:Loc Quick_Dark}"
                                     GroupName="QuickTheme"
                                     IsChecked="{Binding IsWindowsDark, Mode=OneWay}"
                                     Style="{StaticResource SegmentRadio}" />
                        <RadioButton Command="{Binding SetWindowsThemeCommand}"
                                     CommandParameter="light"
                                     Content="{loc:Loc Quick_Light}"
                                     GroupName="QuickTheme"
                                     IsChecked="{Binding IsWindowsLight, Mode=OneWay}"
                                     Style="{StaticResource SegmentRadio}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="0,14,0,8"
                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                       Style="{StaticResource Caption}"
                       Text="{loc:Loc Quick_Navigate}" />

            <UniformGrid Columns="2">
                <Button Margin="0,0,4,4"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="audio"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Audio}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_AudioPage}" />
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,4"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="displays"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Displays}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_Displays}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,4,4"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="system"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.System}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_System}" />
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,4"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="apps"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Apps}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_Apps}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,4,0"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="profiles"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Profiles}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_Profiles}" />
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,0"
                        Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="settings"
                        Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Settings}"
                              Style="{StaticResource PathIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Loc Quick_Settings}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Margin="0,14,0,8"
                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                       Style="{StaticResource Caption}"
                       Text="{loc:Loc Quick_SystemSettings}" />
            <TextBlock Margin="0,0,0,8"
                       Foreground="{DynamicResource TrayX.TextFaintBrush}"
                       Style="{StaticResource Faint}"
                       Text="{loc:Loc Quick_SystemSettingsHint}"
                       TextWrapping="Wrap" />

            <UniformGrid Columns="3">
                <Button Margin="0,0,4,4"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="wifi"
                        Content="{loc:Loc Quick_WiFi}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="2,0,2,4"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="bluetooth"
                        Content="{loc:Loc Quick_Bluetooth}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="4,0,0,4"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="airplane"
                        Content="{loc:Loc Quick_Airplane}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="0,0,4,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="microphone"
                        Content="{loc:Loc Quick_MicrophonePrivacy}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="2,0,2,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="camera"
                        Content="{loc:Loc Quick_CameraPrivacy}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="4,0,0,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="power"
                        Content="{loc:Loc Quick_Power}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="0,4,4,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="powersaver"
                        Content="{loc:Loc Quick_PowerSaver}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="2,4,2,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="nightlight"
                        Content="{loc:Loc Quick_NightLight}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="4,4,0,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="focus"
                        Content="{loc:Loc Quick_Focus}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="0,4,4,0"
                        Padding="8,7"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="notifications"
                        Content="{loc:Loc Quick_Notifications}"
                        Style="{StaticResource GhostButton}" />
            </UniformGrid>

            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="dashboard"
                    Content="{loc:Loc Quick_OpenDashboard}"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Border>
</Window>
