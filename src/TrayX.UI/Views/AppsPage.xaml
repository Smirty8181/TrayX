<UserControl x:Class="TrayX.UI.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchInput"
                         Padding="34,9,12,9"
                         Style="{StaticResource SearchBox}"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Path Width="14"
                      Height="14"
                      Margin="12,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Search}"
                      IsHitTestVisible="False"
                      Stretch="Uniform"
                      Stroke="{DynamicResource TrayX.TextFaintBrush}"
                      StrokeThickness="1.6" />
                <TextBlock Margin="34,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                           IsHitTestVisible="False"
                           Text="{loc:Loc Apps_Search}"
                           Visibility="{Binding Search, Converter={StaticResource InverseStringToVisibility}}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Common_Refresh}">
                    <Path Data="{StaticResource Icon.Refresh}"
                          Style="{StaticResource PathIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding CountText}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,0,14,12"
                    Orientation="Horizontal">
            <RadioButton Command="{Binding SetFilterCommand}"
                         CommandParameter="all"
                         Content="{loc:Loc Apps_All}"
                         GroupName="AppsFilter"
                         IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                         Style="{StaticResource ChipRadio}" />
            <RadioButton Margin="6,0,0,0"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="start"
                         Content="{loc:Loc Apps_Start}"
                         GroupName="AppsFilter"
                         IsChecked="{Binding IsFilterStart, Mode=OneWay}"
                         Style="{StaticResource ChipRadio}" />
            <RadioButton Margin="6,0,0,0"
                         Command="{Binding SetFilterCommand}"
                         CommandParameter="apps"
                         Content="{loc:Loc Apps_Store}"
                         GroupName="AppsFilter"
                         IsChecked="{Binding IsFilterStore, Mode=OneWay}"
                         Style="{StaticResource ChipRadio}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,14,0">
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <Border Margin="0,0,0,10"
                            Style="{StaticResource WarningBar}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource TrayX.WarningBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding Error}" />
                    </Border>

                    <TextBlock Margin="0,8,0,8"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Apps_Loading}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Margin="0,8,0,8"
                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Apps_Empty}"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="12,9"
                                        Background="{DynamicResource TrayX.SurfaceBrush}"
                                        BorderBrush="{DynamicResource TrayX.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                                            <Path Width="15"
                                                  Height="15"
                                                  Data="{StaticResource Icon.Apps}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TrayX.TextFaintBrush}"
                                                  StrokeThickness="1.3" />
                                            <Image Width="26"
                                                   Height="26"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Entry, Converter={StaticResource ShellIcon}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                           Style="{StaticResource Faint}"
                                                           Text="{Binding SourceLabel}" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                           Style="{StaticResource Faint}"
                                                           Text="·" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                           Style="{StaticResource Faint}"
                                                           Text="{Binding SourceHint}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Padding="12,6"
                                                Command="{Binding LaunchCommand}"
                                                Content="{loc:Loc Apps_Launch}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="{loc:Loc Apps_Launch}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
