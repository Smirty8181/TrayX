<UserControl x:Class="TrayX.UI.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             xmlns:ctl="clr-namespace:TrayX.UI.Controls"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,14,8">
            <Border Margin="0,0,0,16"
                    Padding="24"
                    Background="{DynamicResource TrayX.HeroGradientBrush}"
                    BorderBrush="{DynamicResource TrayX.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource TrayX.DisplayFontFamily}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{loc:Loc Dash_HeroTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Body}"
                                   Text="{loc:Loc Dash_HeroSubtitle}" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="audio"
                                    Content="{loc:Loc Dash_OpenAudio}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="displays"
                                    Content="{loc:Loc Dash_OpenDisplays}"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Width="230" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Caption}"
                                           Text="{loc:Loc Dash_MasterVolume}" />
                                <TextBlock Style="{StaticResource Metric}"
                                           Text="{Binding MasterVolumeText}" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Button Command="{Binding MuteCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{Binding MuteTooltip}">
                                    <Grid Width="18" Height="18">
                                        <Path Data="{StaticResource Icon.Volume}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Path Data="{StaticResource Icon.Mute}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                        <Slider Margin="0,6,0,0"
                                Maximum="100"
                                Minimum="0"
                                Style="{StaticResource NeonSlider}"
                                Value="{Binding MasterVolume, Mode=TwoWay}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource MonoValue}"
                                   Text="{Binding DeviceName}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource InfoBar}"
                    Visibility="{Binding HasStats, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Caption}"
                           Text="{loc:Loc Dash_NoData}" />
            </Border>

            <UniformGrid Margin="0,0,0,12" Columns="3">
                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Dash_Cpu}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Metric}" Text="{Binding CpuText}" />
                        <ctl:Sparkline Height="34"
                                       Margin="0,10,0,0"
                                       Maximum="100"
                                       Stroke="{DynamicResource TrayX.AccentBrush}"
                                       Values="{Binding CpuPoints}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Dash_Memory}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Metric}" Text="{Binding MemoryText}" />
                        <ProgressBar Margin="0,14,0,0"
                                     Maximum="100"
                                     Style="{StaticResource NeonProgress}"
                                     Value="{Binding MemoryPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding MemoryDetail}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Dash_Disk}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Metric}" Text="{Binding DiskText}" />
                        <ProgressBar Margin="0,14,0,0"
                                     Maximum="100"
                                     Foreground="{DynamicResource TrayX.SuccessBrush}"
                                     Style="{StaticResource NeonProgress}"
                                     Value="{Binding DiskPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{loc:Loc Dash_Uptime}" />
                        <TextBlock Style="{StaticResource MonoValue}" Text="{Binding UptimeText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Dash_TrayTitle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding TrayHint}" />
                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="tray"
                                Content="{loc:Loc Nav_Tray}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Dash_DisplaysTitle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding DisplaysHint}" />
                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="displays"
                                Content="{loc:Loc Nav_Displays}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc System_Network}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Caption}"
                                           Text="{loc:Loc Dash_NetworkDown}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoValue}" Text="{Binding NetworkInText}" />
                                <ctl:Sparkline Height="34"
                                               Margin="0,8,12,0"
                                               Stroke="{DynamicResource TrayX.AccentBrush}"
                                               Values="{Binding NetInPoints}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Caption}"
                                           Text="{loc:Loc Dash_NetworkUp}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoValue}" Text="{Binding NetworkOutText}" />
                                <ctl:Sparkline Height="34"
                                               Margin="0,8,0,0"
                                               Stroke="{DynamicResource TrayX.PinkBrush}"
                                               Values="{Binding NetOutPoints}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Dash_Modules}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding ModulesOkText}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
