<UserControl x:Class="TrayX.UI.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             xmlns:ctl="clr-namespace:TrayX.UI.Controls"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,14,8">
            <Border Margin="0,0,0,12"
                    Style="{StaticResource InfoBar}"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc System_NoData}" />
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="78" Height="78">
                                <ctl:RingMeter Percent="{Binding CpuPercent}" Stroke="{DynamicResource TrayX.AccentBrush}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding CpuText}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_CPU}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Caption}"
                                           Text="{loc:Loc System_CpuCaption}" />
                            </StackPanel>
                        </Grid>
                        <ctl:Sparkline Height="42"
                                       Margin="0,10,0,0"
                                       Maximum="100"
                                       Stroke="{DynamicResource TrayX.AccentBrush}"
                                       Values="{Binding CpuPoints}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="78" Height="78">
                                <ctl:RingMeter Percent="{Binding MemoryPercent}" Stroke="{DynamicResource TrayX.SuccessBrush}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding MemoryText}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_Memory}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding MemoryDetail}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_Network}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{loc:Loc System_Down}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoValue}" Text="{Binding NetworkInText}" />
                                <ctl:Sparkline Height="28"
                                               Margin="0,6,12,0"
                                               Stroke="{DynamicResource TrayX.AccentBrush}"
                                               Values="{Binding NetInPoints}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{loc:Loc System_Up}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoValue}" Text="{Binding NetworkOutText}" />
                                <ctl:Sparkline Height="28"
                                               Margin="0,6,0,0"
                                               Stroke="{DynamicResource TrayX.PinkBrush}"
                                               Values="{Binding NetOutPoints}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_Drive}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding DiskDetail}" />
                        <ProgressBar Margin="0,10,0,0"
                                     Maximum="100"
                                     Style="{StaticResource NeonProgress}"
                                     Value="{Binding DiskUsedPercent, Mode=OneWay}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{loc:Loc System_Uptime}" />
                                <TextBlock Style="{StaticResource MonoValue}" Text="{Binding UptimeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{loc:Loc System_Processes}" />
                                <TextBlock Style="{StaticResource MonoValue}" Text="{Binding ProcessCountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource Faint}"
                                           Text="{loc:Loc System_Battery}" />
                                <TextBlock Style="{StaticResource MonoValue}"
                                           Text="{Binding BatteryText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_TopProcesses}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Height="3"
                                                         Margin="0,3,12,0"
                                                         Maximum="100"
                                                         Style="{StaticResource NeonProgress}"
                                                         Value="{Binding Share, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                   Style="{StaticResource MonoValue}"
                                                   Text="{Binding MemoryText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="{loc:Loc System_Modules}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                       Style="{StaticResource Faint}"
                                                       Text="{Binding Details}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                   Style="{StaticResource Faint}"
                                   Text="{Binding CoreInfo}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
