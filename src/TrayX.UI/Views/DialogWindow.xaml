<Window x:Class="TrayX.UI.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrayX.UI.Localization"
        Title="TrayX"
        Icon="pack://application:,,,/Assets/trayx.ico"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource TrayX.FontFamily}"
        Foreground="{DynamicResource TrayX.TextBrush}">
    <Border Margin="18"
            Padding="24"
            Background="{DynamicResource TrayX.SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource TrayX.BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="8"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource H2}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="12,0,0,0"
                        Padding="0"
                        Click="OnCancelClick"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Common_Cancel}">
                    <Path Width="10"
                          Height="10"
                          Data="{StaticResource Icon.Close}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource TrayX.TextMutedBrush}"
                       Style="{StaticResource Body}" />

            <Border x:Name="InputHost"
                    Margin="0,16,0,0"
                    Padding="2"
                    BorderBrush="{DynamicResource TrayX.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBox x:Name="InputBox"
                         Padding="12,9"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource TrayX.AccentBrush}"
                         FontSize="13"
                         Foreground="{DynamicResource TrayX.TextBrush}"
                         TextChanged="OnInputChanged" />
            </Border>

            <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,8,0"
                        Click="OnCancelClick"
                        Content="{loc:Loc Common_Cancel}"
                        Style="{StaticResource GhostButton}" />
                <Button x:Name="OkButton"
                        Click="OnOkClick"
                        Content="{loc:Loc Common_Continue}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
