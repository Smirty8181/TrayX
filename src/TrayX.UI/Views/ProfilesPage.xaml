<UserControl x:Class="TrayX.UI.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding CountText}" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                           Style="{StaticResource Faint}"
                           Text="{loc:Loc Profiles_CaptureHint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Common_Refresh}">
                    <Path Data="{StaticResource Icon.Refresh}"
                          Style="{StaticResource PathIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Margin="8,0,0,0"
                        Command="{Binding SaveCommand}"
                        Content="{loc:Loc Profiles_Save}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,14,12" Style="{StaticResource InfoBar}">
            <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                       Style="{StaticResource Body}"
                       Text="{loc:Loc Profiles_Note}" />
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,0,14,0" Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Margin="0,8,0,8"
                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Profiles_Empty}"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,10" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14"
                                                Height="14"
                                                Margin="0,3,10,0"
                                                VerticalAlignment="Top"
                                                Background="{Binding AccentBrush}"
                                                CornerRadius="7" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource H2}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding VolumeText}" />
                                    <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding ThemeText}" />
                                    <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                               Style="{StaticResource Faint}"
                                               Text="{Binding CreatedText}" />

                                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                        <Button Command="{Binding ApplyCommand}"
                                                Content="{loc:Loc Profiles_Apply}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="{loc:Loc Profiles_ApplyHint}" />
                                        <Button Margin="6,0,0,0"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="{loc:Loc Profiles_Delete}">
                                            <Path Data="{StaticResource Icon.Trash}"
                                                  Style="{StaticResource PathIcon}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,8,10,12" Style="{StaticResource CardAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Profiles_ScheduleTitle}" />
                        <TextBlock Margin="0,4,0,10"
                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding ScheduleSummary}" />
                        <WrapPanel>
                            <ComboBox Width="220"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding ScheduledProfile, Mode=TwoWay}"
                                      Style="{StaticResource ComboBox}" />
                            <TextBox Width="90"
                                     Margin="8,0,0,0"
                                     Padding="10,7"
                                     Style="{StaticResource SearchBox}"
                                     Text="{Binding ScheduleTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc Profiles_ScheduleTimeHint}" />
                        </WrapPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SaveScheduleCommand}"
                                    Content="{loc:Loc Profiles_ScheduleSave}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding DisableScheduleCommand}"
                                    Content="{loc:Loc Profiles_ScheduleDisable}"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
