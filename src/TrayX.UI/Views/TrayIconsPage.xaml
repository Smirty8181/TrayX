<UserControl x:Class="TrayX.UI.Views.TrayIconsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrayX.UI.Localization"
             FontFamily="{StaticResource TrayX.FontFamily}"
             Foreground="{DynamicResource TrayX.TextBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource TrayX.SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TrayX.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Padding="34,9,12,9"
                         Style="{StaticResource SearchBox}"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Path Width="14"
                      Height="14"
                      Margin="12,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Search}"
                      IsHitTestVisible="False"
                      Stretch="Uniform"
                      Stroke="{DynamicResource TrayX.TextFaintBrush}"
                      StrokeThickness="1.6" />
                <TextBlock Margin="34,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TrayX.TextFaintBrush}"
                           IsHitTestVisible="False"
                           Text="{loc:Loc Tray_Search}"
                           Visibility="{Binding Search, Converter={StaticResource InverseStringToVisibility}}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="{loc:Loc Common_Refresh}">
                    <Path Data="{StaticResource Icon.Refresh}"
                          Style="{StaticResource PathIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Caption}"
                           Text="{Binding CountText}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,14,12">
            <Border Margin="0,0,0,10"
                    Style="{StaticResource WarningBar}"
                    Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{DynamicResource TrayX.TextBrush}"
                           Style="{StaticResource Body}"
                           Text="{Binding NoticeText}"
                           TextWrapping="Wrap" />
            </Border>

            <WrapPanel>
                <ComboBox MinWidth="150"
                          ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding GroupOptions}"
                          SelectedValue="{Binding GroupMode, Mode=TwoWay}"
                          SelectedValuePath="Value"
                          Style="{StaticResource ComboBox}"
                          ToolTip="{loc:Loc Tray_GroupHint}" />
                <ComboBox MinWidth="150"
                          Margin="8,0,0,0"
                          ItemTemplate="{StaticResource ChoiceTemplate}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedValue="{Binding SortMode, Mode=TwoWay}"
                          SelectedValuePath="Value"
                          Style="{StaticResource ComboBox}"
                          ToolTip="{loc:Loc Tray_SortHint}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding ToggleOverflowCommand}"
                        Style="{StaticResource GhostButton}"
                        ToolTip="{loc:Loc Tray_OverflowHint}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12"
                              Height="12"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Chevron}"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Loc Tray_Overflow}" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        Content="{loc:Loc Tray_OpenSettings}"
                        Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding RestartExplorerCommand}"
                        Content="{loc:Loc Tray_Restart}"
                        Style="{StaticResource GhostButton}" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,0,14,0" Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Margin="0,8,0,8"
                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                           Style="{StaticResource Body}"
                           Text="{loc:Loc Tray_Empty}"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Margin="2,4,0,6"
                                           Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                           Style="{StaticResource H3}"
                                           Text="{Binding Header}"
                                           Visibility="{Binding Header, Converter={StaticResource StringToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="12,9"
                                                    Background="{DynamicResource TrayX.SurfaceBrush}"
                                                    BorderBrush="{DynamicResource TrayX.BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="30"
                                                          Height="30"
                                                          VerticalAlignment="Center">
                                                        <Path Width="15"
                                                              Height="15"
                                                              Data="{StaticResource Icon.Tray}"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource TrayX.TextFaintBrush}"
                                                              StrokeThickness="1.3" />
                                                        <Image Width="26"
                                                               Height="26"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding Image}"
                                                               Stretch="Uniform" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,12,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{DynamicResource TrayX.TextFaintBrush}"
                                                                   Style="{StaticResource Faint}"
                                                                   Text="{Binding Subtitle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                                           Style="{StaticResource Caption}"
                                                                           Text="{Binding KindText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                                           Style="{StaticResource Caption}"
                                                                           Text="{Binding MonitorText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                                           Style="{StaticResource Caption}"
                                                                           Text="{Binding StateText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <Button Margin="0,0,4,0"
                                                                Command="{Binding ActivateCommand}"
                                                                Style="{StaticResource IconButton}"
                                                                ToolTip="{loc:Loc Tray_Activate}">
                                                            <Path Data="{StaticResource Icon.Play}"
                                                                  Style="{StaticResource PathIcon}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                        <Button Margin="0,0,8,0"
                                                                Command="{Binding ContextMenuCommand}"
                                                                Style="{StaticResource IconButton}"
                                                                ToolTip="{loc:Loc Tray_ContextMenu}">
                                                            <Path Data="{StaticResource Icon.Panel}"
                                                                  Style="{StaticResource PathIcon}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                        <TextBlock Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TrayX.TextMutedBrush}"
                                                                   Style="{StaticResource Caption}"
                                                                   Text="{loc:Loc Tray_Show}"
                                                                   Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}" />
                                                        <ToggleButton IsChecked="{Binding IsPromoted, Mode=TwoWay}"
                                                                      Style="{StaticResource Switch}"
                                                                      Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,8,0,0" Style="{StaticResource InfoBar}">
                    <TextBlock Foreground="{DynamicResource TrayX.TextMutedBrush}"
                               Style="{StaticResource Body}"
                               Text="{loc:Loc Tray_AdvancedNote}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
