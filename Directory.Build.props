<Project>

  <PropertyGroup>
    <TrayXTargetFramework>net10.0</TrayXTargetFramework>
    <TrayXWindowsTargetFramework>net10.0-windows10.0.22621.0</TrayXWindowsTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Product>TrayX</Product>
    <Authors>TrayX</Authors>
  </PropertyGroup>

</Project>
